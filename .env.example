# PlantLens AI - Environment Configuration Example
# Copy this file to .env.local and populate with your API keys.
# NEVER commit .env.local or production secrets to Git!

# 1. Google Gemini API Key for Multimodal Plant Vision and Botanist Assistant
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative Google AI key name (supported interchangeably)
# GOOGLE_API_KEY=your_google_api_key_here

# 2. Optional: Supabase Authentication and PostgreSQL Persistence
# When configured, enables cross-device cloud sync and user accounts.
# When omitted, PlantLens AI operates in offline-first localStorage mode with full JSON backup/restore.
# Create a free project at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
